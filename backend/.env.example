# ---------------------------------------------------------------------------
# Copie este arquivo para ".env" e ajuste os valores.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# Ambiente: development | test | production
NODE_ENV=development

# Porta do servidor HTTP
PORT=3000

# URL do banco. Para subir rapido com Docker: docker compose up -d
# (a stack do docker-compose.yml publica o Postgres na porta 5432)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tasksdb?schema=public"

# Segredo do JWT (OBRIGATORIO). Gere um valor forte, ex.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-este-valor-por-um-segredo-forte-de-48-bytes
JWT_EXPIRES_IN=1h

# Custo do bcrypt (10-12 e o intervalo recomendado)
BCRYPT_SALT_ROUNDS=10

# CORS: origens permitidas, separadas por virgula. "*" libera todas (apenas dev).
CORS_ORIGIN=*

# Rate limit global (janela em ms / maximo de requisicoes por IP na janela)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
